generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model comments {
  id              Int             @id @default(autoincrement())
  reportId        Int
  authorId        String
  content         String
  createdAt       DateTime        @default(now())
  users           users           @relation(fields: [authorId], references: [id])
  expense_reports expense_reports @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model expense_lines {
  id              Int             @id @default(autoincrement())
  reportId        Int
  date            DateTime
  amount          Decimal         @db.Decimal(12, 2)
  category        ExpenseCategory
  description     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  expense_reports expense_reports @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model expense_reports {
  id               Int                @id @default(autoincrement())
  title            String
  dateFrom         DateTime
  dateTo           DateTime
  status           ReportStatus       @default(DRAFT)
  isArchived       Boolean            @default(false)
  submittedAt      DateTime?
  approvedAt       DateTime?
  paidAt           DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  ownerId          String
  comments         comments[]
  expense_lines    expense_lines[]
  users            users              @relation(fields: [ownerId], references: [id])
  report_approvers report_approvers[]
  report_history   report_history[]
  stale_alerts     stale_alerts[]

  @@index([ownerId])
  @@index([status])
  @@index([status, submittedAt])
  @@index([submittedAt])
}

model report_approvers {
  reportId        Int
  approverId      String
  assignedAt      DateTime        @default(now())
  users           users           @relation(fields: [approverId], references: [id], onDelete: Cascade)
  expense_reports expense_reports @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@id([reportId, approverId])
  @@index([approverId])
}

model report_history {
  id              Int             @id @default(autoincrement())
  reportId        Int
  actorId         String
  fromStatus      ReportStatus?
  toStatus        ReportStatus
  reason          String?
  createdAt       DateTime        @default(now())
  users           users           @relation(fields: [actorId], references: [id])
  expense_reports expense_reports @relation(fields: [reportId], references: [id])

  @@index([reportId])
}

model stale_alerts {
  id              Int             @id @default(autoincrement())
  reportId        Int
  approverId      String
  dismissedAt     DateTime?
  createdAt       DateTime        @default(now())
  users           users           @relation(fields: [approverId], references: [id], onDelete: Cascade)
  expense_reports expense_reports @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, approverId])
  @@index([approverId])
}

model users {
  id               String             @id
  email            String             @unique
  name             String?
  role             Role               @default(EMPLOYEE)
  createdAt        DateTime           @default(now())
  comments         comments[]
  expense_reports  expense_reports[]
  report_approvers report_approvers[]
  report_history   report_history[]
  stale_alerts     stale_alerts[]
}

enum ExpenseCategory {
  TRAVEL
  MEALS
  ACCOMMODATION
  SUPPLIES
  SOFTWARE
  EQUIPMENT
  OTHER
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

enum Role {
  EMPLOYEE
  APPROVER
}
