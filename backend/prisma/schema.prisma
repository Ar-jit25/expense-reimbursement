// ============================================================
// Prisma Schema -- Expense Reimbursement
// ============================================================
// Authentication: Supabase Auth (auth.users, UUID-based).
// This schema lives in the PostgreSQL public schema.
// User.id is the Supabase Auth UUID -- no separate serial PK.
//
// Total is always server-computed from ExpenseLine.amount.
// It is never stored on ExpenseReport.
//
// Lifecycle timestamps (submittedAt, approvedAt, paidAt) are
// used for correct dashboard analytics and stale-alert detection.
// updatedAt is retained for general record tracking only.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Enums
// ============================================================

enum Role {
  EMPLOYEE
  APPROVER
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

// Fixed expense categories. Adding a category requires a migration
// by design -- it prevents inconsistent free-text input that would
// break category-based dashboard aggregation.
enum ExpenseCategory {
  TRAVEL
  MEALS
  ACCOMMODATION
  SUPPLIES
  SOFTWARE
  EQUIPMENT
  OTHER
}

// ============================================================
// User (application profile)
// ============================================================
// id is the Supabase Auth UUID. Using auth UUID as PK avoids
// a redundant integer PK and a separate foreign-key lookup
// when resolving identity from the JWT in the Express middleware.
//
// The backend creates this profile on first successful login
// if it does not already exist.

model User {
  id        String   @id
  email     String   @unique
  name      String?
  role      Role     @default(EMPLOYEE)
  createdAt DateTime @default(now())

  ownedReports        ExpenseReport[]  @relation("ReportOwner")
  approverAssignments ReportApprover[]
  historyEntries      ReportHistory[]
  comments            Comment[]
  staleAlerts         StaleAlert[]

  @@map("users")
}

// ============================================================
// ExpenseReport
// ============================================================
// No total column. Authoritative total is always computed by the
// server as SUM(ExpenseLine.amount) for this report's lines.
//
// isArchived is a separate boolean -- not a lifecycle status.
// Archive is a visibility toggle; a PAID report can be archived.
//
// Lifecycle timestamps set by backend on each transition:
//   submittedAt -- DRAFT -> SUBMITTED
//   approvedAt  -- SUBMITTED -> APPROVED
//   paidAt      -- APPROVED -> PAID
// updatedAt must NOT be used for lifecycle analytics.

model ExpenseReport {
  id         Int          @id @default(autoincrement())
  title      String
  dateFrom   DateTime
  dateTo     DateTime
  status     ReportStatus @default(DRAFT)
  isArchived Boolean      @default(false)

  submittedAt DateTime?
  approvedAt  DateTime?
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation("ReportOwner", fields: [ownerId], references: [id])

  lines     ExpenseLine[]
  approvers ReportApprover[]
  history   ReportHistory[]
  comments  Comment[]
  alerts    StaleAlert[]

  @@index([ownerId])
  @@index([status])
  @@index([submittedAt])
  @@index([status, submittedAt])

  @@map("expense_reports")
}

// ============================================================
// ExpenseLine
// ============================================================
// Lines editable only while report is DRAFT -- enforced by the
// application layer (not by a DB cross-table constraint).
//
// amount uses Decimal(12,2) -- PostgreSQL NUMERIC -- for exact
// monetary arithmetic. Float is not used (binary float cannot
// exactly represent all decimal fractions).

model ExpenseLine {
  id       Int           @id @default(autoincrement())
  reportId Int
  report   ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  date        DateTime
  amount      Decimal         @db.Decimal(12, 2)
  category    ExpenseCategory
  description String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportId])
  @@map("expense_lines")
}

// ============================================================
// ReportApprover (many-to-many join table)
// ============================================================
// Composite PK prevents duplicate assignment.
// Eligibility check (Role=APPROVER) is enforced by application.

model ReportApprover {
  reportId   Int
  approverId String

  report   ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  approver User          @relation(fields: [approverId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([reportId, approverId])
  @@index([approverId])
  @@map("report_approvers")
}

// ============================================================
// ReportHistory (immutable audit log)
// ============================================================
// Append-only. No update or delete endpoints exist for this table.
// fromStatus is nullable for the initial creation entry.
// reason is required by the application when toStatus = REJECTED.
// onDelete: Restrict prevents accidental cascade deletion.

model ReportHistory {
  id       Int           @id @default(autoincrement())
  reportId Int
  report   ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Restrict)

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  fromStatus ReportStatus?
  toStatus   ReportStatus
  reason     String?

  createdAt DateTime @default(now())

  @@index([reportId])
  @@map("report_history")
}

// ============================================================
// Comment
// ============================================================
// Separate from ReportHistory. History = status transitions.
// Comments = freeform text by owner or approver.
// Both are immutable after creation (no update/delete endpoint).

model Comment {
  id       Int           @id @default(autoincrement())
  reportId Int
  report   ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  content   String
  createdAt DateTime @default(now())

  @@index([reportId])
  @@map("comments")
}

// ============================================================
// StaleAlert
// ============================================================
// One record per (report, approver) pair.
// dismissedAt null = active alert.
// Reappears when dismissedAt < now() - REDISPLAY_THRESHOLD_DAYS
// and report is still SUBMITTED.
// Unique constraint enables upsert on dismiss.

model StaleAlert {
  id         Int           @id @default(autoincrement())
  reportId   Int
  report     ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  approverId String
  approver   User   @relation(fields: [approverId], references: [id], onDelete: Cascade)

  dismissedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([reportId, approverId])
  @@index([approverId])
  @@map("stale_alerts")
}

