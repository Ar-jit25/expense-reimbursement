# Backend environment variables
# Copy this to .env and fill in your values.
# Never commit .env to git.
# Get these from: Supabase Dashboard -> Project Settings -> Database -> Connection String

# Transaction pooler (port 6543) - used by Prisma for runtime queries
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler (port 5432) - used by Prisma for migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Express server
PORT=3001
NODE_ENV=development

# Supabase Auth configuration
# Get from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="your-publishable-anon-key"

# CORS - set to your Vercel frontend URL in production
FRONTEND_URL="https://your-project.vercel.app"

# Development only - set to 'true' to use mock authentication for automated tests.
# NEVER set this in production (Render). Absence of this var means production auth.
# MOCK_AUTH=true
